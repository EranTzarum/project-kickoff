{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-sql.js\"" },
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-env-edit.js\"" },
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/migration-number-check.js\"" }
        ],
        "description": "Block destructive raw SQL run from a shell, and shell writes to real .env files or to a migration with a taken prefix"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-env-edit.js\"" },
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/migration-number-check.js\"" }
        ],
        "description": "Block edits to real .env files; refuse a migration prefix that already exists locally or on origin/main"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/service-role-guard.js\"" }
        ],
        "description": "Warn when the service-role key is referenced outside the allowlisted directories"
      }
    ]
  }
}
