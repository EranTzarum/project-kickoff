{
  "projectName": "Example CRM",
  "projectSlug": "example-crm",
  "oneLiner": "Multi-tenant CRM with a public listings site for small brokerages.",
  "primaryUser": "an agent in the field on a phone",
  "langs": ["es", "en"],
  "country": "Spain",
  "stackProfile": "supabase-react-vercel",
  "tenantTable": "agencies",
  "tenantKey": "agency_id",
  "jwtClaim": "agency_id",
  "roles": ["owner", "member"],
  "glossary": ["\"3.5\" in a note means 3,500,000 EUR", "phone numbers compare digits-only"],
  "entities": ["properties — a listing; owned by its listing agent; scoped by agency_id; created_at = first source event", "clients — a buyer or seller; owned by created_by; scoped by agency_id"],
  "enums": ["properties.status: draft (not advertised) / active (advertised) / sold — lifecycle only; is_published is visibility; archive is manual_archive_state"],
  "domainRules": ["match floor = budget_min or budget_max * 0.875; ceiling = budget_max * 1.075 (owner, kickoff)"],
  "idempotency": ["properties: (agency_id, external_ref) non-partial unique; price_history: (property_id, price, seen_at) unique"],
  "outOfScope": ["billing", "native mobile app"],
  "peerReadPaths": "team list via a peer SELECT policy on memberships; colleague listings via a SECURITY DEFINER RPC",
  "serviceRoleDirs": ["apps/api/src/admin/"],
  "anonSurface": ["public_listings view", "leads insert (policy-checked)"],
  "identityFields": "display_name, license_number (stamped from memberships at invite)",
  "integrations": ["none"],
  "platformLimits": ["Vercel Hobby: 1 cron run per day", "Supabase Free: no backups, pauses after 7 idle days", "Express JSON body 100 kB default"],
  "sizeBudgets": "JSON body 1 MB (signature PNGs); uploads 10 MB; functions 10 s",
  "supabaseProjectId": "abcdefghijklmnopqrst",
  "testProjectId": "tttttttttttttttttttt",
  "backupPlan": "Supabase Pro daily + weekly encrypted export",
  "prodUrl": "https://crm.example.com",
  "previewUrlPattern": "https://*-example.vercel.app",
  "devUrl": "http://localhost:5173",
  "devPort": "5173",
  "smtpProvider": "Resend",
  "oauthProviders": ["none"],
  "payments": false,
  "aiProvider": "none",
  "deployTarget": "vercel",
  "environments": [
    { "name": "Local", "web": "http://localhost:5173", "branch": "-", "db": "local", "api": "http://localhost:8000", "redirects": "http://localhost:5173/**", "realUsers": false, "disposable": true },
    { "name": "Preview", "web": "https://*-example.vercel.app", "branch": "non-main", "db": "tttttttttttttttttttt", "redirects": "https://*-example.vercel.app/**", "realUsers": false, "disposable": false },
    { "name": "Test", "db": "tttttttttttttttttttt", "realUsers": false, "disposable": true },
    { "name": "Prod", "web": "https://crm.example.com", "branch": "main", "db": "abcdefghijklmnopqrst", "api": "https://crm.example.com/api", "redirects": "https://crm.example.com/**", "realUsers": true, "disposable": false }
  ],
  "env": [
    { "key": "VITE_SUPABASE_URL", "purpose": "web → Supabase", "secret": false },
    { "key": "VITE_SUPABASE_ANON_KEY", "purpose": "web anon key", "secret": false },
    { "key": "SUPABASE_URL", "purpose": "api → Supabase", "secret": false },
    { "key": "SUPABASE_ANON_KEY", "purpose": "api anon key", "secret": false },
    { "key": "SUPABASE_SERVICE_ROLE_KEY", "purpose": "admin path only", "preview": "no", "secret": true },
    { "key": "SUPABASE_PROJECT_ID", "purpose": "types regen", "secret": false },
    { "key": "PORT", "purpose": "api port", "preview": "n/a", "prod": "n/a", "secret": false }
  ],
  "gates": ["npm run typecheck", "npm test -w apps/web", "npm test -w apps/api", "npm run build -w apps/web"],
  "deployCmd": "push to main (Vercel git integration)",
  "typesTargets": ["apps/web/src/lib/database.types.ts", "apps/api/src/lib/database.types.ts"],
  "lineEndings": "CRLF",
  "vaultPath": "Projects/Example CRM",
  "freeTier": true
}
